{
  "name": "mmorpg-top-100",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "admin:grant": "node scripts/set-admin-claim.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate": "node scripts/apply-sql-migration.mjs",
    "db:seed-games": "node scripts/seed-games.mjs",
    "db:import-servers": "node scripts/import-approved-servers.mjs",
    "db:verify-voting": "node scripts/verify-voting-migration.mjs",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:check": "tsc -p worker/tsconfig.json && wrangler deploy --dry-run",
    "worker:dev": "wrangler dev --local"
  },
  "dependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.18.0",
    "jose": "^6.2.10",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "firebase-admin": "^14.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
